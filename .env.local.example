# MongoDB connection
MONGODB_URI=mongodb://<username>:<password>@ac-eq2d3xj-shard-00-00.sgbqkio.mongodb.net:27017/protech_touch_db?ssl=true&directConnection=true&authSource=admin&retryWrites=true&w=majority
MONGODB_DB=protech_touch_db
MONGODB_ALLOW_INVALID_CERTS=false

# API base path for browser requests
NEXT_PUBLIC_API_BASE_URL=/api

# Authentication secrets
ADMIN_EMAIL=admin@protechtouch.com
ADMIN_INITIAL_PASSWORD=<minimum-8-characters>
AUTH_SESSION_SECRET=<long-random-secret>
ENABLE_LOCAL_ADMIN_FALLBACK=false

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ADMIN_EMAILS=
GOOGLE_REDIRECT_ORIGIN=

# Internal maintenance endpoints (disabled unless explicitly enabled)
ENABLE_DEBUG_ENV=false
DEBUG_ENV_TOKEN=<long-random-token>
ENABLE_INIT_API=false
INIT_API_TOKEN=<long-random-token>
ENABLE_TEST_API=false
TEST_API_TOKEN=<long-random-token>
